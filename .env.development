# Local development against the Firebase Emulator Suite.
#
# Committed on purpose. Every value here is a local-only constant and none of
# them is a secret — that is the whole point of decision 19 in the design doc.
# Next.js loads this file when NODE_ENV is `development`, so `npm run dev` picks
# it up and a production build does not.
#
# See .env.example for what each variable means and for the deployed-only set.
# Override anything here in `.env.local`, which takes precedence and is ignored
# by git.

FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1:8080
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-spinnerly
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
