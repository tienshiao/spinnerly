# Spinnerly environment variables
#
# ---------------------------------------------------------------------------
# You almost certainly do not need to copy this file.
# ---------------------------------------------------------------------------
#
# Local development runs against the Firebase Emulator Suite (design doc
# decision 19), and every value it needs is already committed in
# `.env.development` — none of them is a secret. `npm run dev:emulator` works on
# a fresh clone with no setup.
#
# This file exists to document the full set, including the deployed-only
# variables that are set in the Vercel dashboard and never live on disk.
# Copy it to `.env.local` only if you need to override something.

# ---------------------------------------------------------------------------
# Local — emulator. Committed in .env.development; repeated here for reference.
# ---------------------------------------------------------------------------

# The single switch between local and cloud. When this is set, the Admin SDK
# talks to the emulator and skips credential resolution entirely, which is why
# no service account key is needed — or wanted — on a developer machine.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# The client SDK does not read FIRESTORE_EMULATOR_HOST; it needs an explicit
# connectFirestoreEmulator() call, so the browser gets its own copy of the host.
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1:8080

# The `demo-` prefix is load-bearing: the emulator treats such project IDs as
# strictly local and refuses to contact Google, so a misconfigured client cannot
# reach a real project. Keep it.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-spinnerly

# The emulator does not validate the API key, but the client SDK requires the
# field to be non-empty.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key

# ---------------------------------------------------------------------------
# Deployed only — set in the Vercel dashboard, scoped to Production and Preview
# separately. Never write these to a file in the repository. Provisioning the
# projects that produce them is TASK-27; wiring Vercel is TASK-25.
# ---------------------------------------------------------------------------

# The public origin, used as `metadataBase` so that og:image resolves to an
# absolute URL. A crawler fetching the card has no page to resolve a relative
# path against, so getting this wrong is an unfurl with no picture — cached
# against the share link exactly as a good one would be.
#
# Optional. Unset, lib/site.ts falls back to VERCEL_PROJECT_PRODUCTION_URL,
# which Vercel provides and which is correct once a custom domain is attached.
# Set this when the site should advertise a domain Vercel does not know about,
# and set it per environment — a preview deployment pointing its cards at the
# production domain would serve the wrong wheel's image.
#
# Needs a scheme. `spinnerly.example` is rejected at build; use
# `https://spinnerly.example`.
NEXT_PUBLIC_SITE_URL=

# Server-side credentials, from the service account JSON. The three fields are
# `project_id`, `client_email` and `private_key`.
#
# FIREBASE_PRIVATE_KEY is stored differently depending on where you paste it:
# an env file conventionally holds escaped \n, while Vercel's dashboard accepts
# the real newlines straight out of the JSON. lib/firebase/admin.ts accepts
# either form, so a value copied in one direction and back still works.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Public web config, from the Firebase console. Safe to ship to the browser —
# access is governed by security rules, not by the API key.
#
# The project ID appears both here and as FIREBASE_PROJECT_ID above on purpose.
# Collapsing them would mean either leaking a server variable into the browser
# bundle or reading a NEXT_PUBLIC_ value on the server, and the two happen to be
# equal only by coincidence.
#
# authDomain, storageBucket and messagingSenderId are deliberately omitted:
# Firestore needs none of them, and v1 has no accounts, uploads or push.
# appId is kept because App Check needs it (TASK-24).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
