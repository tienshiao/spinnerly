# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Opted in: neither holds a secret. .env.development is the emulator config,
# which is local-only by construction; .env.example documents the full set.
!.env.example
!.env.development

# firebase emulator
/firebase-debug.log
/firestore-debug.log
/ui-debug.log
/.firebase

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
